@@ -122,6 +122,145 @@ interface AskToolDetails {
 
 type AskUIResult = AskResponse;
 
+/**
+ * Optional in-process transport used by the Anywhere companion extension.
+ * The event bus is process-local, so this never exposes a prompt by itself:
+ * a transport must synchronously claim the request, then resolve only this
+ * generated tool-call id. Without a claimant, ask_user keeps its normal TUI.
+ */
+const ANYWHERE_ASK_PROTOCOL_VERSION = 1;
+const ANYWHERE_ASK_REQUEST_CHANNEL = "anywhere:ask:v1:request";
+const ANYWHERE_ASK_CANCEL_CHANNEL = "anywhere:ask:v1:cancel";
+const ANYWHERE_ASK_PROBE_CHANNEL = "anywhere:ask:v1:probe";
+
+interface AnywhereAskRequest {
+   version: number;
+   id: string;
+   question: string;
+   context?: string;
+   options: QuestionOption[];
+   allowMultiple: boolean;
+   allowFreeform: boolean;
+   allowComment: boolean;
+   timeout?: number;
+   signal?: AbortSignal;
+   claim: () => boolean;
+   respond: (response: unknown) => boolean;
+}
+
+interface AnywhereAskProbe {
+   version: number;
+   report: (capability: { version: number; remoteAsk: boolean }) => void;
+}
+
+function normalizeAnywhereResponse(
+   response: unknown,
+   options: QuestionOption[],
+   allowMultiple: boolean,
+   allowFreeform: boolean,
+   allowComment: boolean,
+): AskUIResult | null {
+   if (response === null || response === undefined || typeof response !== "object") return null;
+   const record = response as Record<string, unknown>;
+
+   if (record.kind === "freeform") {
+      // The native zero-option path always opens a text input, even when a
+      // caller supplied allowFreeform: false, so keep remote behavior aligned.
+      if ((!allowFreeform && options.length > 0) || typeof record.text !== "string") return null;
+      return createFreeformResponse(record.text);
+   }
+
+   if (record.kind !== "selection" || !Array.isArray(record.selections)) return null;
+   const selections = record.selections
+      .filter((selection): selection is string => typeof selection === "string")
+      .map((selection) => selection.trim())
+      .filter(Boolean);
+   const uniqueSelections = [...new Set(selections)];
+   const allowed = new Set(options.map((option) => option.title));
+   if (
+      uniqueSelections.length === 0
+      || (!allowMultiple && uniqueSelections.length !== 1)
+      || uniqueSelections.some((selection) => !allowed.has(selection))
+   ) {
+      return null;
+   }
+
+   const comment = allowComment && typeof record.comment === "string" ? record.comment : undefined;
+   return createSelectionResponse(uniqueSelections, comment);
+}
+
+/**
+ * Ask the authenticated Anywhere bridge, if it is actively running. EventBus
+ * handlers are invoked synchronously up to their first await, so claim() lets
+ * us distinguish a live bridge from the ordinary local-UI fallback without
+ * exposing a global mutable resolver.
+ */
+function askViaAnywhere(
+   pi: ExtensionAPI,
+   request: Omit<AnywhereAskRequest, "claim" | "respond">,
+): Promise<AskUIResult | null> | undefined {
+   if (request.signal?.aborted) return Promise.resolve(null);
+
+   let claimed = false;
+   let settled = false;
+   let timer: ReturnType<typeof setTimeout> | undefined;
+   let resolveResult: (result: AskUIResult | null) => void = () => undefined;
+   const result = new Promise<AskUIResult | null>((resolve) => {
+      resolveResult = resolve;
+   });
+
+   const cleanup = () => {
+      if (timer) clearTimeout(timer);
+      request.signal?.removeEventListener("abort", onAbort);
+   };
+   const settle = (response: AskUIResult | null, notifyBridge: boolean): boolean => {
+      if (settled) return false;
+      settled = true;
+      cleanup();
+      if (notifyBridge) {
+         pi.events.emit(ANYWHERE_ASK_CANCEL_CHANNEL, {
+            version: ANYWHERE_ASK_PROTOCOL_VERSION,
+            id: request.id,
+         });
+      }
+      resolveResult(response);
+      return true;
+   };
+   const onAbort = () => settle(null, true);
+
+   request.signal?.addEventListener("abort", onAbort, { once: true });
+   const envelope: AnywhereAskRequest = {
+      ...request,
+      claim: () => {
+         if (claimed || settled) return false;
+         claimed = true;
+         return true;
+      },
+      respond: (response) => {
+         if (!claimed || settled) return false;
+         const normalized = normalizeAnywhereResponse(
+            response,
+            request.options,
+            request.allowMultiple,
+            request.allowFreeform,
+            request.allowComment,
+         );
+         return settle(normalized, false);
+      },
+   };
+
+   pi.events.emit(ANYWHERE_ASK_REQUEST_CHANNEL, envelope);
+   if (!claimed) {
+      cleanup();
+      return undefined;
+   }
+
+   if (!settled && request.timeout && request.timeout > 0) {
+      timer = setTimeout(() => settle(null, true), request.timeout);
+   }
+   return result;
+}
